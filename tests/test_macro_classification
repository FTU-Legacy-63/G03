(() => {
  const originalPhase = pgPhase;
  const results = [];

  try {
    pgPhase = 3;

    // Checkpoint commentary: test every threshold and branch.
    const checkpointCases = [
      { name: "GDP = 5, inflation = 4", gdp: 5, inf: 4, expected: "maintained" },
      { name: "Inflation = 3.5", gdp: 5, inf: 3.5, expected: "maintained" },
      { name: "Inflation just below 3.5", gdp: 5, inf: 3.49, expected: "low" },
      { name: "Inflation = 4.5", gdp: 5, inf: 4.5, expected: "maintained" },
      { name: "Inflation just above 4.5", gdp: 5, inf: 4.51, expected: "elevated" },
      { name: "GDP just below 5, inflation = 3", gdp: 4.99, inf: 3, expected: "weak-low" },
      { name: "GDP just below 5, inflation = 4", gdp: 4.99, inf: 4, expected: "weak-mid" },
      { name: "GDP just below 5, inflation = 4.51", gdp: 4.99, inf: 4.51, expected: "weak-high" }
    ];

    for (const c of checkpointCases) {
      const text = pgCheckpointEconomicComment({
        gdp_growth: c.gdp,
        inflation: c.inf
      });

      const patterns = {
        maintained: "price pressure remains under control",
        low: "inflation stays low",
        elevated: "inflation is still elevated",
        "weak-low": "Inflation is contained",
        "weak-mid": "Growth remains weak while inflation stays within the target range",
        "weak-high": "Growth remains weak while inflation is still elevated"
      };

      results.push({
        test: c.name,
        passed: text.includes(patterns[c.expected]),
        actualComment: text
      });
    }

    // Missing data should not produce a false economic conclusion.
    results.push({
      test: "Checkpoint rejects missing GDP",
      passed: pgCheckpointEconomicComment({
        gdp_growth: null,
        inflation: 4
      }) === ""
    });

    // Final outcome: test all four combinations and exact boundaries.
    const finalCases = [
      { name: "GDP=6, inflation=4", gdp: 6, inf: 4, expected: "Well-balanced outcome" },
      { name: "GDP=6, inflation just above 4", gdp: 6, inf: 4.01, expected: "Growth-leaning outcome" },
      { name: "GDP just below 6, inflation=4", gdp: 5.99, inf: 4, expected: "Price-stability-leaning outcome" },
      { name: "GDP just below 6, inflation just above 4", gdp: 5.99, inf: 4.01, expected: "Stagflation-leaning outcome" }
    ];

    for (const c of finalCases) {
      const actual = pgFinalEconomicOutcome({
        gdp_growth: c.gdp,
        inflation: c.inf
      });

      results.push({
        test: c.name,
        passed: actual.title === c.expected,
        actualTitle: actual.title,
        expectedTitle: c.expected
      });
    }

    // Important: test null/empty values in the final classification.
    const missing = pgFinalEconomicOutcome({
      gdp_growth: null,
      inflation: ""
    });

    results.push({
      test: "Final outcome rejects missing values",
      passed: missing.title === "Economic outcome pending",
      actualTitle: missing.title
    });

    console.table(results.map(({test, passed, actualTitle, expectedTitle}) => ({
      test, passed, actualTitle, expectedTitle
    })));

    return {
      passed: results.filter(x => x.passed).length,
      total: results.length,
      failures: results.filter(x => !x.passed)
    };
  } finally {
    pgPhase = originalPhase;
  }
})();
